<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key><string>en</string>
    <key>CFBundleLocalizations</key><array><string>en</string><string>ru</string></array>
    <key>CFBundleExecutable</key><string>SwampConverter</string>
    <key>CFBundleIdentifier</key><string>app.swampconverter</string>
    <key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
    <key>CFBundleName</key><string>Swamp Converter</string>
    <key>CFBundleDisplayName</key><string>Swamp Converter</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleIconFile</key><string>AppIcon</string>
    <key>CFBundleShortVersionString</key><string>@VERSION@</string>
    <key>CFBundleVersion</key><string>@BUILD@</string>
    <key>LSMinimumSystemVersion</key><string>26.0</string>
    <key>LSApplicationCategoryType</key><string>public.app-category.utilities</string>
    <!-- Menu-bar app: no Dock icon until a Studio window opens (the app switches the activation policy itself). -->
    <key>LSUIElement</key><true/>
    <key>LSMultipleInstancesProhibited</key><true/>
    <key>NSPrincipalClass</key><string>NSApplication</string>
    <key>NSHighResolutionCapable</key><true/>
    <key>NSSupportsAutomaticTermination</key><false/>
    <key>NSSupportsSuddenTermination</key><false/>
    <key>NSHumanReadableCopyright</key><string>Copyright 2026 Swamp Converter</string>

    <!-- Usage strings: English here, Russian in ru.lproj/InfoPlist.strings (the in-app language setting does not change what macOS shows in its own prompts). -->
    <key>NSAppleEventsUsageDescription</key><string>Swamp Converter reads your Finder selection and the address of the page open in your browser, so the shortcut can convert or download what you are looking at.</string>
    <key>NSDesktopFolderUsageDescription</key><string>Swamp Converter converts files you drop on it, including files on your Desktop.</string>
    <key>NSDocumentsFolderUsageDescription</key><string>Swamp Converter converts files you drop on it, including files in Documents.</string>
    <key>NSDownloadsFolderUsageDescription</key><string>Swamp Converter converts files you drop on it and can watch folders you choose, such as Downloads.</string>
    <key>NSRemovableVolumesUsageDescription</key><string>Swamp Converter converts files you drop on it, including files on external drives.</string>
    <key>NSNetworkVolumesUsageDescription</key><string>Swamp Converter converts files you drop on it, including files on network volumes.</string>
    <key>NSSpeechRecognitionUsageDescription</key><string>Swamp Converter recognises speech in your audio and video files on this Mac to write a transcript. Nothing is sent anywhere.</string>

    <!-- Dock icon / Open With drops: never becomes the default handler of anything (Alternate rank). -->
    <key>CFBundleDocumentTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeName</key><string>Any file</string>
            <key>CFBundleTypeRole</key><string>Viewer</string>
            <key>LSHandlerRank</key><string>Alternate</string>
            <key>LSItemContentTypes</key><array><string>public.item</string><string>public.folder</string></array>
        </dict>
    </array>

    <!-- swampconverter://download?url=<encoded>&mode=<best|max|universal|audio-m4a|audio-mp3> -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key><string>Swamp Converter link</string>
            <key>CFBundleURLSchemes</key><array><string>swampconverter</string></array>
        </dict>
    </array>

    <!-- Services (right-click > Services in any app). Menu titles are localised through the language keys. -->
    <key>NSServices</key>
    <array>
        <dict>
            <key>NSMenuItem</key><dict><key>default</key><string>Convert with Swamp Converter</string><key>ru</key><string>Конвертировать в Swamp Converter</string></dict>
            <key>NSMessage</key><string>convertFiles</string>
            <key>NSPortName</key><string>SwampConverter</string>
            <key>NSSendFileTypes</key><array><string>public.item</string></array>
        </dict>
        <dict>
            <key>NSMenuItem</key><dict><key>default</key><string>Download with Swamp Converter</string><key>ru</key><string>Скачать в Swamp Converter</string></dict>
            <key>NSMessage</key><string>downloadLink</string>
            <key>NSPortName</key><string>SwampConverter</string>
            <key>NSSendTypes</key><array><string>public.utf8-plain-text</string><string>public.url</string></array>
        </dict>
    </array>
</dict>
</plist>
